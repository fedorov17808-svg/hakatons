# ═══════════════════════════════════════════════════════════
# CreditPulse AI v7.2.0 Enterprise — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ── Creditcoin CC3 Network ──
RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CONTRACT_ADDRESS=0x358925c5839a36bB2181786B8763Da0653B0f438
CHAIN_ID=102031

# ── Oracle Signing Key (DO NOT COMMIT REAL KEYS) ──
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ── Inter-Node Authentication ──
# DON_API_KEY=your_secure_don_inter_node_api_key_here

# ── Cache Configuration & Ordering ──
# CACHE_DIR=/tmp
# CACHE_TTL=900          # DeFiLlama disk cache TTL in seconds (15 min)
# DEX_CACHE_TTL=180      # DexScreener cache TTL in seconds (3 min)
# PRICE_CACHE_TTL=120    # Token price cache TTL in seconds (2 min)

# ── Gemini AI Advisory (optional, for qualitative narrative) ──
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Federated DON Node Endpoints ──
# Set these to enable PRODUCTION deployment mode.
# When unset, system defaults to DEMO_LOCAL (all nodes on 127.0.0.1:8011/8012/8013).
# DON_NODE_1_URL=https://don-node-1.example.com
# DON_NODE_2_URL=https://don-node-2.example.com
# DON_NODE_3_URL=https://don-node-3.example.com

# ── Node Identity (for multi-node deployments) ──
# NODE_NAME=node_0
# NODE_REGION=us-east-1

# ── Autonomous Keeper Daemon ──
# Set to "false" to disable automatic keeper cycles on startup.
KEEPER_ENABLED=true
# KEEPER_INTERVAL_SECONDS=86400  # Default: 24h

# ── Vercel/Serverless ──
# VERCEL=1  # Auto-detected by Vercel runtime
