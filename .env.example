# ==============================================================================
# CreditPulse AI - Environment Configuration Template
# Copy this file to .env or .env.local and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# URL of the FastAPI Risk Engine backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Blockchain & Creditcoin Testnet (CC3) Configuration
# ------------------------------------------------------------------------------
# RPC endpoint for Creditcoin Testnet CC3 (Chain ID: 102031)
RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Deployed CreditPulseScore smart contract address on Creditcoin Testnet
CONTRACT_ADDRESS=0xa3AD1879Af301B7c158ff9844541BA0Ca8Eb353b

# Private key of the relayer / deployer account for on-chain risk score proofs
# WARNING: Never commit real private keys to version control!
PRIVATE_KEY=your_private_key_here

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Host & port for local FastAPI server
HOST=0.0.0.0
PORT=8000
