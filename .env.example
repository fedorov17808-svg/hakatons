# ═══════════════════════════════════════════════════════════
# CreditPulse AI v8.0.0 Enterprise — Root Configuration Template
# ═══════════════════════════════════════════════════════════
# Copy this to .env and fill in real values before running.

# ── Backend Configuration ──
PRIVATE_KEY=0x_your_private_key_here
RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CONTRACT_ADDRESS=0x358925c5839a36bB2181786B8763Da0653B0f438
CHAIN_ID=102031
DON_API_KEY=your_don_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── DON Cluster Node Endpoints ──
# For local dev: leave defaults (localhost)
# For Docker: set automatically in docker-compose.yml
# For VPS: set to actual remote endpoints
DON_NODE_ALPHA_URL=http://127.0.0.1:8011
DON_NODE_BETA_URL=http://127.0.0.1:8012
DON_NODE_GAMMA_URL=http://127.0.0.1:8013

# ── Autonomous Keeper ──
KEEPER_ENABLED=true

# ── Cache Configuration & Ordering ──
CACHE_DIR=/tmp
CACHE_TTL=900
DEX_CACHE_TTL=180
PRICE_CACHE_TTL=120

# ── Frontend Configuration ──
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONTRACT_ADDRESS=0x358925c5839a36bB2181786B8763Da0653B0f438
NEXT_PUBLIC_CREDITCOIN_RPC=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CHAIN_ID=102031
NEXT_PUBLIC_API_KEY=
